{
  "schema_version": 1,
  "id": "invoice-persistence",
  "steps": [
    {
      "id": "save",
      "method": "POST",
      "path": "/v1/invoices",
      "json": {
        "invoice_id": "invoice-demo",
        "customer": "fixture-customer",
        "amount_cents": 750
      },
      "expect_status": 200
    },
    {
      "id": "observe",
      "method": "GET",
      "path": "/v1/invoices/invoice-demo",
      "expect_status": 200,
      "assert_json": [
        {
          "pointer": "/invoice_id",
          "equals": "invoice-demo"
        },
        {
          "pointer": "/amount_cents",
          "equals": 750
        }
      ]
    }
  ]
}
